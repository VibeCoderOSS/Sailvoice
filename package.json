{
  "name": "qwen3-tts-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ship-42 local-first Electron + MLX Qwen3-TTS desktop app for Apple Silicon",
  "author": "Ship-42",
  "license": "MIT",
  "keywords": [
    "ship-42",
    "local-ai",
    "text-to-speech",
    "mlx",
    "qwen3",
    "whisperx",
    "electron",
    "apple-silicon"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-launcher.mjs",
    "dev:renderer": "vite",
    "dev:electron": "electron electron/main.cjs",
    "dev:python": "python3 python_service/run.py",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "start": "electron electron/main.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.1.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.15",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  }
}
